[Unit]
Description=Pi-Anzeige control server
After=network.target

[Service]
Type=simple
User=pi-anzeige
Group=pi-anzeige
Environment=PORT=80
Environment=PI_ANZEIGE_DATA=/var/lib/pi-anzeige/config.json
ExecStart=/usr/bin/node /opt/pi-anzeige/bin/pi-anzeige.js
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/pi-anzeige
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
